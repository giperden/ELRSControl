<Window x:Class="ELRSControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ELRSControl"
        xmlns:models="clr-namespace:ELRSControl.Models"
        mc:Ignorable="d"
        MouseMove="Window_MouseMove"
        Title="ELRS Control - CRSF" MinHeight="508" MinWidth="669" Height="508" Width="669" WindowStyle="None" AllowsTransparency="True" Icon="/ELRSControl.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="20" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Tag" Value="#E81123"/>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Tag" Value="#2000FF4A"/>
        </Style>

        <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBackground" 
                        Background="White" 
                        CornerRadius="4" 
                        Width="12" 
                        Height="18"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBackground" Property="Background" Value="#E6FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThreePositionSliderStyle" TargetType="Slider">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Maximum" Value="2000"/>
            <Setter Property="Minimum" Value="1000"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Ticks" Value="1000, 1500, 2000"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackBackground" 
                            Background="#20FFFFFF" 
                            CornerRadius="3" 
                            Height="6" 
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,0" StartPoint="0.5,1" ColorInterpolationMode="ScRgbLinearInterpolation" SpreadMethod="Reflect">
                <GradientStop Color="#FF2D1A1D" Offset="0.105"/>
                <GradientStop Color="#FF251A30" Offset="0.918"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="FollowGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#25007ACC" Offset="0"/>
                    <GradientStop Color="#158A2BE2" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="189*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" Height="16">
                <TextBlock Text="Пульт • CRSF" Foreground="Wheat" Opacity="0.9" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32" Width="138">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeBtn_Click" Content="&#xE921;"/>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeBtn_Click" Content="{Binding MaximizeIcon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseBtn_Click" Content="&#xE10A;"/>
            </StackPanel>

            <Border x:Name="TopMenu" Grid.Row="1" CornerRadius="10,10,10,10" Background="#0AFFFFFF" Margin="12,0,12,0"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,1">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Адрес" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <MenuItem x:Name="AddressMenuButton" Header="{Binding SelectedAddress}" Style="{StaticResource MenuItemStyle}">
                            <MenuItem.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer Collection="{Binding Source={x:Static local:App.SharedViewModel}, Path=Addresses}"/>

                                    <Separator/>
                                    <MenuItem Header="Добавить..." Command="{Binding Source={x:Static local:App.SharedViewModel}, Path=ShowAddAddressCommand}" StaysOpenOnClick="True">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource SelectableMenuItemStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static local:App.SharedViewModel}, Path=IsAddAddressVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <MenuItem StaysOpenOnClick="True">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource SelectableMenuItemStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static local:App.SharedViewModel}, Path=IsAddAddressVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                        <MenuItem.Header>
                                            <DockPanel Width="120">
                                                <Button Content="+" DockPanel.Dock="Right" Style="{StaticResource AddButtonStyle}" Command="{Binding Source={x:Static local:App.SharedViewModel}, Path=ConfirmAddAddressCommand}"/>
                                                <TextBox Text="{Binding Source={x:Static local:App.SharedViewModel}, Path=NewAddressText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </CompositeCollection>
                            </MenuItem.ItemsSource>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource SelectableMenuItemStyle}">
                                    <Setter Property="Command" Value="{Binding Source={x:Static local:App.SharedViewModel}, Path=SelectAddressCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button Content="✕" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource DeleteButtonStyle}" Command="{Binding Source={x:Static local:App.SharedViewModel}, Path=DeleteAddressCommand}" CommandParameter="{Binding}" x:Name="DeleteBtn"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="White" Margin="2,0"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="FF">
                                            <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="C8">
                                            <Setter TargetName="DeleteBtn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Тяга" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <TextBox Text="{Binding Throttle, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Рыскание" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <TextBox Text="{Binding Yaw, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Крен" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <TextBox Text="{Binding Roll, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Тангаж" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <TextBox Text="{Binding Pitch, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Baudrate" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <MenuItem x:Name="BaudMenuButton" Header="{Binding SelectedBaudRate}" Style="{StaticResource MenuItemStyle}">
                            <MenuItem Header="9600" Command="{Binding SelectBaudRateCommand}" CommandParameter="9600" Style="{StaticResource SelectableMenuItemStyle}"/>
                            <MenuItem Header="19200" Command="{Binding SelectBaudRateCommand}" CommandParameter="19200" Style="{StaticResource SelectableMenuItemStyle}"/>
                            <MenuItem Header="38400" Command="{Binding SelectBaudRateCommand}" CommandParameter="38400" Style="{StaticResource SelectableMenuItemStyle}"/>
                            <MenuItem Header="57600" Command="{Binding SelectBaudRateCommand}" CommandParameter="57600" Style="{StaticResource SelectableMenuItemStyle}"/>
                            <MenuItem Header="115200" Command="{Binding SelectBaudRateCommand}" CommandParameter="115200" Style="{StaticResource SelectableMenuItemStyle}"/>
                            <Separator/>
                            <MenuItem Header="Свое значение:" IsHitTestVisible="False" Foreground="#A0FFFFFF" FontSize="10"/>
                            <TextBox Text="{Binding CustomBaudRateText, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="6,2" MinWidth="60" Width="Auto"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>

                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Устройство" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <MenuItem x:Name="PortMenuButton" Header="{Binding SelectedPort}" Style="{StaticResource MenuItemStyle}"
          ItemsSource="{Binding AvailablePorts}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource SelectableMenuItemStyle}">
                                    <Setter Property="Header" Value="{Binding PortName}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.SelectPortCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding PortName}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <Button x:Name="ConnectBtn" 
        Style="{StaticResource HeaderButtonStyle}" 
        Content="{Binding ConnectBtnContent}" 
        Background="{Binding ConnectBtnBackground}"
        Command="{Binding ToggleConnectionCommand}"
        VerticalAlignment="Stretch" Margin="10"/>

                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="12,10,12,10" Width="70">
                <Button Style="{StaticResource HeaderButtonStyle}" Margin="0,0,12,10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="SliderWindow_Click">
                    <Button.Content>
                        <Grid>
                            <Grid.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </Grid.LayoutTransform>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="&#xE9E9;"  FontSize="10" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <TextBlock Text="&#xE9E9;"  FontSize="10" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </StackPanel>
                        </Grid>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource HeaderButtonStyle}" Content="&#xE70D;" Margin="0,0,12,0" FontSize="5" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Click="Menu_Drop_Click"/>


            </StackPanel>

            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="RightMenu" Grid.Column="1" CornerRadius="0,0,10,10" Background="#0AFFFFFF" Margin="12,0,12,12" Visibility="Collapsed"/>
                <StackPanel x:Name="RightMenuContent" Grid.Column="1" Orientation="Vertical" Margin="12,1,12,12" Visibility="Collapsed">
                    <TextBlock Text="Канал 5" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch4Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch4, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 6" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch5Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch5, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 7" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch6Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch6, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 8" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch7Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch7, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 9" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch8Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch8, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 10" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch9Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch9, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 11" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch10Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch10, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 12" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch11Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch11, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 13" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch12Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch12, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 14" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch13Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch13, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 15" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch14Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch14, Mode=TwoWay}"/>
                    <TextBlock Text="Канал 16" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="11"/>
                    <Slider x:Name="Ch15Slider" Style="{StaticResource ThreePositionSliderStyle}" Value="{Binding Ch15, Mode=TwoWay}" />
                </StackPanel>

                <Viewbox x:Name="Joystick" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="1" >
                    <StackPanel Orientation="Horizontal" >

                        <models:JoystickControl x:Name="RightJoystick" Width="200" Height="200"/>
                        <models:JoystickControl x:Name="LeftJoystick" Width="200" Height="200"/>

                    </StackPanel>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</Window>
