<UserControl x:Class="ELRSControl.Models.JoystickControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="200"
             Width="200" Height="200">
    <Grid x:Name="MainGrid" Background="#20000000" ClipToBounds="True">
        <Canvas x:Name="JoystickCanvas" Background="#15FFFFFF" MouseDown="JoystickCanvas_MouseDown" MouseMove="JoystickCanvas_MouseMove" MouseUp="JoystickCanvas_MouseUp" MouseLeave="JoystickCanvas_MouseLeave">
            <Line X1="0" Y1="100" X2="200" Y2="100" Stroke="#25FFFFFF" StrokeThickness="1"/>
            <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#25FFFFFF" StrokeThickness="1"/>
            <Ellipse Canvas.Left="25" Canvas.Top="25" Width="150" Height="150" 
                     Fill="Transparent" Stroke="#15FFFFFF" StrokeThickness="2"/>
            <Ellipse x:Name="JoystickKnob" Canvas.Left="85" Canvas.Top="85" Width="30" Height="30" 
                     Fill="#2D7ACC" Stroke="#0066CC" StrokeThickness="2" Cursor="Hand"/>
        </Canvas>
    </Grid>
</UserControl>
