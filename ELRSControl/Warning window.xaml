<Window x:Class="ELRSControl.Warning_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ELRSControl"
        mc:Ignorable="d"
        MouseMove="Window_MouseMove"
        Title="Warning_window" 
        
        SizeToContent="WidthAndHeight" 
        ResizeMode="NoResize"
        MinWidth="320"
        
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="20" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,0" StartPoint="0.5,1.3" ColorInterpolationMode="ScRgbLinearInterpolation" SpreadMethod="Reflect">
                <GradientStop Color="#CC692323" Offset="0.105"/>
                <GradientStop Color="#CC444403" Offset="0.950"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="FollowGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#255100CC" Offset="0"/>
                    <GradientStop Color="#158A2BE2" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Rectangle Fill="#0AFFFFFF" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RadiusX="12" RadiusY="12"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                <TextBlock x:Name="ErrorHeader" Text="Ошибка" Foreground="Wheat" Opacity="0.9" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32" Width="92">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeBtn_Click" Content="&#xE921;"/>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseBtn_Click" Content="&#xE10A;"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Внимание!" Foreground="Wheat" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            <TextBlock Grid.Row="2" x:Name="TextError" Text="Произошла ошибка!" Foreground="Wheat" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="15,10,15,0"/>
            <Button Grid.Row="3" Content="Пон" Margin="10,10,10,10" Click="OKBtn_Click" Style="{StaticResource HeaderButtonStyle}"/>
        </Grid>


    </Grid>
</Window>
