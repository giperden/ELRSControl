<Window x:Class="ELRSControl.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ELRSControl"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800" WindowStyle="None" AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="12" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="#25FFFFFF" 
                        Width="{TemplateBinding Width}" 
                        Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0,0" StartPoint="0.5,1" ColorInterpolationMode="ScRgbLinearInterpolation" SpreadMethod="Reflect">
                <GradientStop Color="#FF2D1A1D" Offset="0.105"/>
                <GradientStop Color="#FF251A30" Offset="0.918"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- свечение за курсором -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush x:Name="FollowGradient" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#25007ACC" Offset="0"/>
                    <GradientStop Color="#158A2BE2" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                <TextBlock Text="Пульт • CRSF" Foreground="Wheat" Opacity="0.9" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"/>
                <Button Style="{StaticResource CaptionButtonStyle}" Content="{Binding MaximizeIcon}"/>
                <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE10A;"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Background="#0AFFFFFF" Orientation="Horizontal"  Margin="12,0,12,12">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Адрес" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4"/>
                                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                                                <Popup x:Name="SubMenuPopup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                                                    <Border BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush EndPoint="0,0" StartPoint="0.5,1" ColorInterpolationMode="ScRgbLinearInterpolation" SpreadMethod="Reflect">
                                                                <GradientStop Color="#FF2D1A1D" Offset="0.105"/>
                                                                <GradientStop Color="#FF251A30" Offset="0.918"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>

                        <MenuItem Header="FF">
                            <MenuItem Header="FF"/>
                            <MenuItem Header="C8"/>
                            <MenuItem Header="Добавить"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Тяга" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBox x:Name="Trottle" Text="1500"/>
                </StackPanel>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Тангаж" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBox x:Name="Tangagh" Text="1500"/>
                </StackPanel>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Рыскание" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBox x:Name="Ryskanie" Text="1500"/>
                </StackPanel>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Устройство" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Menu.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4"/>
                                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                                                <Popup x:Name="SubMenuPopup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" Focusable="False" PopupAnimation="Fade">
                                                    <Border BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,4,0,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush EndPoint="0,0" StartPoint="0.5,1" ColorInterpolationMode="ScRgbLinearInterpolation" SpreadMethod="Reflect">
                                                                <GradientStop Color="#FF2D1A1D" Offset="0.105"/>
                                                                <GradientStop Color="#FF251A30" Offset="0.918"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>

                        <MenuItem Header="COM9">
                            <MenuItem Header="COM9"/>
                            <MenuItem Header="COM8"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock Text="Baudrate" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <ComboBox x:Name="BaudCombo" Width="100"/>
                </StackPanel>
                <Button Style="{StaticResource HeaderButtonStyle}" Content="Старт" VerticalAlignment="Stretch" Margin="10"/>
                <Separator Style="{StaticResource HeaderSeparatorStyle}" VerticalAlignment="Stretch" Margin="0,10"/>
                <StackPanel Orientation="Vertical" Margin="5">
                    <Button Style="{StaticResource HeaderButtonStyle}" Content="Настройки" VerticalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="1">
                    <Canvas Name="LayoutRoot1" Grid.Row="1">
                        <Ellipse x:Name="Joystick1" Stroke="White"
                            Width="{Binding ElementName=LayoutRoot, Path=ActualHeight}"
                            Height="{Binding ElementName=LayoutRoot, Path=ActualHeight}" 
                            Canvas.Left="0" Canvas.Top="0" Cursor="">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#20000000"/>
                                    <GradientStop Color="#35FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Knob1" Fill="#FFF4F4F5" Stroke="Black"
                            Cursor="Hand" Panel.ZIndex="2"/>
                    </Canvas>
                </DockPanel>
                <DockPanel Grid.Column="0">
                    <Canvas Name="LayoutRoot" Grid.Row="1">
                        <Ellipse x:Name="Joystick" Stroke="White"
                            Width="{Binding ElementName=LayoutRoot, Path=ActualHeight}"
                            Height="{Binding ElementName=LayoutRoot, Path=ActualHeight}" 
                            Canvas.Left="0" Canvas.Top="0" Cursor="">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#20000000"/>
                                    <GradientStop Color="#35FFFFFF" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Knob" Fill="#FFF4F4F5" Stroke="Black"
                            Cursor="Hand" Panel.ZIndex="2"/>
                    </Canvas>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
